# URL base del backend FastAPI (IP de la red local)
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.103:8000

# true (por defecto): el frontend usa respuestas simuladas de src/lib/mocks.ts.
# Cambiar a false cuando el backend tenga los endpoints listos.
NEXT_PUBLIC_USE_MOCKS=true

# Debe coincidir con MAX_UPLOAD_SIZE_MB del backend
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10

# Debe coincidir con OLLAMA_MODEL del backend; forma parte de la clave de caché.
NEXT_PUBLIC_OLLAMA_MODEL=llama3.2:1b